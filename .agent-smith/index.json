    },
    {
      "id": "skill:plugin-feedback",
      "type": "skill",
      "name": "plugin-feedback",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/plugin-feedback/SKILL.md",
      "description": "Report a bug, a wrong trigger, a gap or an improvement for an oss-maintainer skill by opening an issue on the plugin's repository (lfnovo/oss-maintainer), never by editing the installed plugin. Use when an oss-maintainer skill misbehaves, a profile field or preset does not fit a project, or the maintainer has a suggestion for the plugin."
    },
    {
      "id": "skill:process-discussions",
      "type": "skill",
      "name": "process-discussions",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/process-discussions/SKILL.md",
      "description": "Facilitate a repository's GitHub Discussions queue by mapping the queue, decomposing each idea into distinct needs, verifying claims in the code, proposing an outcome (exploring, incubating, graduated, parked, combined, answered, bug) and drafting the reply, one decision at a time, with the maintainer approving every text before it is posted. Use when the maintainer asks to process, facilitate or reply to Discussions."
    },
    {
      "id": "policy:process-discussions:user-invoked",
      "type": "policy",
      "name": "process-discussions user-invoked only",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/process-discussions/SKILL.md",
      "description": "The skill runs only on explicit user invocation, never by model auto-selection."
    },
    {
      "id": "script:read-discussions",
      "type": "script",
      "name": "read_discussions",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/process-discussions/scripts/read_discussions.py",
      "description": "Bundled with the process-discussions skill."
    },
    {
      "id": "skill:release",
      "type": "skill",
      "name": "release",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/release/SKILL.md",
      "description": "Orchestrate a release of the current repository behind human gates, from changelog audit and version decision through a coverage table, validation on the real artifact, the cut, notes and credits, an explicit GO before the first action that can start distribution, verification from the registry and closure. Use when preparing, testing, cutting or publishing a release."
    },
    {
      "id": "policy:release:user-invoked",
      "type": "policy",
      "name": "release user-invoked only",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/release/SKILL.md",
      "description": "The skill runs only on explicit user invocation, never by model auto-selection."
    },
    {
      "id": "script:run-record",
      "type": "script",
      "name": "run_record",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/release/scripts/run_record.py",
      "description": "Bundled with the release skill."
    },
    {
      "id": "skill:review-pr",
      "type": "skill",
      "name": "review-pr",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/review-pr/SKILL.md",
      "description": "Review a pull request as the maintainer, judging the diff against the project's own rules (agent docs, architecture, contribution guides) with existing AI reviews treated as hypotheses to verify, and report P0/P1/P2 findings for the maintainer to decide what to post. Use when the maintainer asks to review a PR or the open PR queue."
    },
    {
      "id": "policy:review-pr:user-invoked",
      "type": "policy",
      "name": "review-pr user-invoked only",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/review-pr/SKILL.md",
      "description": "The skill runs only on explicit user invocation, never by model auto-selection."
    },
    {
      "id": "skill:smoke-e2e",
      "type": "skill",
      "name": "smoke-e2e",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/smoke-e2e/SKILL.md",
      "description": "Run the repository's end-to-end smoke journey against a running instance (health checks, the API journey declared in .maintainer/smoke/journey.md, UI verification in a browser when one is available), collect evidence, clean up everything created, and give a GO / NO-GO verdict with the status of every check. Use when smoke-testing a running stack, gating a release, or when asked to run the smoke test."
    },
    {
      "id": "skill:triage",
      "type": "skill",
      "name": "triage",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/triage/SKILL.md",
      "description": "Classify open GitHub issues into the project's triage outcomes (by default close, needs-design or ready) after checking their premises against the code, one confirmed verdict at a time, so design and development can pick them up. Use when the maintainer asks to triage issues, a specific issue, or the intake queue."
    },
    {
      "id": "policy:triage:user-invoked",
      "type": "policy",
      "name": "triage user-invoked only",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/skills/triage/SKILL.md",
      "description": "The skill runs only on explicit user invocation, never by model auto-selection."
    },
    {
      "id": "agent:smoke-e2e",
      "type": "agent",
      "name": "smoke-e2e",
      "plugin": "oss-maintainer",
      "canonicalPath": "plugins/oss-maintainer/agents/smoke-e2e.md",
      "description": "End-to-end smoke test of a running instance for release preparation. Executes the repository's smoke journey (.maintainer/smoke/journey.md) via the API, verifies the UI in a browser when one is available, collects evidence, cleans up, and reports GO / NO-GO with the status of every check. Last barrier before a release."
    }
  ],
